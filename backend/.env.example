# ==========================================================
# 团建活动策划 Agent — 后端环境变量模板
# 用法：复制为 .env 再填真实值
#     cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交真实 Key
# ==========================================================

# ---------- LLM（必填）----------
# 走 OpenAI 兼容接口，DeepSeek / 通义 / 本地 vLLM 等均可
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat
# 单次 LLM 请求的超时秒数。
# 注意变量名必须是 LLM_TIMEOUT_SECONDS，代码按此名读取
LLM_TIMEOUT_SECONDS=60
# 评测用的 LLM-as-judge 模型（可选；留空则沿用 LLM_MODEL_ID）
LLM_JUDGE_MODEL=

# ---------- 高德地图（必填）----------
# 申请地址 https://console.amap.com/ ，需「Web 服务」类型 Key
# 未配置会在服务启动时直接报错
AMAP_API_KEY=

# ---------- 可选数据源（未配置则对应功能优雅降级，不阻塞主流程）----------
# 博查 AI 搜索 https://open.bochaai.com
#   用于餐饮 / 住宿 / 游玩攻略的 Web 搜索；未配置时 web_search 返回空列表
BOCHA_API_KEY=
# 聚合数据 12306 火车票 https://www.juhe.cn
#   未配置时火车票价走 LLM 常识估算并标注「估算」
JUHE_TRAIN_KEY=
# Unsplash 图片 https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
LOG_LEVEL=INFO
