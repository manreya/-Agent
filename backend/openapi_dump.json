        ],
        "summary": "查询天气",
        "description": "查询指定城市的天气信息(高德仅提供未来3-4天预报)",
        "operationId": "get_weather_api_map_weather_get",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "城市名称",
