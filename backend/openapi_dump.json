    "/api/map/poi": {
      "get": {
        "tags": [
          "地图服务"
        ],
        "summary": "搜索POI",
        "description": "根据关键词搜索POI(兴趣点); 城市名会自动归一化(如『杭州西湖区』-> 杭州市)",
        "operationId": "search_poi_api_map_poi_get",
        "parameters": [
          {
            "name": "keywords",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "搜索关键词",
              "examples": [
                "团建场地"
              ],
              "title": "Keywords"
            },
            "description": "搜索关键词"
          },
          {
            "name": "city",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "城市",
              "examples": [
                "杭州"
              ],
              "title": "City"
            },
            "description": "城市"
          },
          {
            "name": "citylimit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "是否限制在城市范围内",
              "default": true,
              "title": "Citylimit"
            },
            "description": "是否限制在城市范围内"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/POISearchResponse"
                }
              }
            }
