  },
  "components": {
    "schemas": {
      "EventParseBody": {
        "properties": {
          "raw_text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Raw Text",
            "description": "用户原始输入(自由文本)",
            "example": "10月底组织30人团建，预算3万，上海周边一天"
          },
          "team_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Team Id",
            "description": "团队ID(可选; 有历史活动记录时解析 prompt 会注入'上次你们……'上下文)"
          }
        },
        "type": "object",
        "required": [
          "raw_text"
        ],
        "title": "EventParseBody",
        "description": "需求解析请求体(自由文本入口)"
      },
      "EventPlan": {
        "properties": {
          "proposals": {
            "items": {
              "$ref": "#/components/schemas/Proposal"
            },
            "type": "array",
            "title": "Proposals",
            "description": "四路提案(transport/venue/flow/food 各一项,按category区分)"
          },
          "conflict_points": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Conflict Points",
            "description": "冲突点"
          },
          "risk_report": {
            "type": "string",
            "title": "Risk Report",
            "description": "风险报告",
            "default": ""
          },
          "pref_coverage": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Pref Coverage",
            "description": "偏好覆盖情况,如 {'爬山': '已覆盖(张三、李四)'}"
          },
          "checklist": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checklist",
            "description": "任务清单(TaskChecklist.model_dump(): 分工/采购/通知文案, 审批通过后产出)"
          },
          "memory_status": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memory Status",
            "description": "团队记忆写入结果(written/reason/retro_key)。写入可能因存储故障降级放行, 前端要如实告知, 不能假定已存档"
          }
        },
        "type": "object",
        "title": "EventPlan",
        "description": "最终方案: 四路 Proposal 汇总"
      },
      "EventRequest": {
        "properties": {
          "raw_text": {
            "type": "string",
            "title": "Raw Text",
            "description": "用户原始输入文本(结构化输入时可为空)",
            "default": "",
            "example": "20人团建,预算1万,10月1日北京出发"
          },
          "people_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "People Count",
            "description": "参与人数(LLM抽取)"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date",
            "description": "活动开始日期 YYYY-MM-DD(LLM抽取)"
          },
          "date_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date End",
            "description": "活动结束日期 YYYY-MM-DD(多日活动填写, 单日/未提及为 null)(LLM抽取)"
          },
          "budget": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget",
            "description": "总预算(元; 非人均)(LLM抽取)"
          },
          "origin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin",
            "description": "出发地/集合地(LLM抽取)"
          },
          "destination": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination",
            "description": "目的地/活动城市(与出发地同城可缺省, LLM抽取)"
          },
          "transport_pref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transport Pref",
            "description": "优先通行方式,如 高铁/自驾/大巴/不限(LLM抽取)"
          },
          "activity_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activity Type",
            "description": "活动类型,如 团建/聚餐/户外(LLM抽取)"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Fields",
            "description": "缺失的必填项 key 列表"
          }
        },
        "type": "object",
        "title": "EventRequest",
        "description": "团建活动策划请求(规范化后的结构化需求)\n\n两个来源共用本模型:\n- 表单/API 直传的结构化输入 -> 程序化组装(零 LLM);\n- 自由文本 -> LLM 抽取(缺失项记录在 missing_fields, 由调用方驱动补全)。\n因此 raw_text 默认空串: 结构化输入时没有原文可填, 也不该强迫 LLM 回抄。",
        "example": {
          "activity_type": "户外拓展",
          "budget": 10000.0,
          "date": "2026-10-01",
          "missing_fields": [],
          "origin": "北京",
          "people_count": 20,
          "raw_text": "20人团建,预算1万,10月1日北京出发,想搞户外拓展"
        }
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Location": {
        "properties": {
          "longitude": {
            "type": "number",
            "title": "Longitude",
            "description": "经度"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude",
            "description": "纬度"
          }
        },
        "type": "object",
        "required": [
          "longitude",
          "latitude"
        ],
        "title": "Location",
        "description": "地理位置"
      },
      "MealOptions": {
        "properties": {
          "day": {
            "type": "string",
            "title": "Day",
            "description": "所属天次, 如 'D1'(多日)或 '当天'(单日)"
          },
          "meal_type": {
            "type": "string",
            "title": "Meal Type",
            "description": "餐次: 早餐/午餐/晚餐"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/ProposalOption"
            },
            "type": "array",
            "title": "Options",
            "description": "该顿 2-3 家候选餐厅"
          }
        },
        "type": "object",
        "required": [
          "day",
          "meal_type"
        ],
        "title": "MealOptions",
        "description": "单顿餐饮的候选餐厅组(逐顿挑选, 审批页按 顿 勾选)"
      },
      "POIDetailResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "title": "POIDetailResponse",
        "description": "POI详情响应"
      },
      "POIInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "POI ID"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "名称"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "类型"
          },
          "address": {
            "type": "string",
            "title": "Address",
            "description": "地址"
          },
          "location": {
            "$ref": "#/components/schemas/Location",
            "description": "经纬度坐标"
          },
          "tel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tel",
            "description": "电话"
          },
          "rating": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating",
